! Narrow CDV gap with complete-step extraction-to-injection total-temperature feedback.
! Match fan_inlet (CFD outflow) with fan_outlet (CFD total inflow).
! Gap boundary values sampled from the continuous-nozzle solution at step 100000.
! Initial extraction static p=6676.328911229583 Pa (+100 Pa perturbation).
! Injection pt=6894.750052334262 Pa and angle=0.05988380066238474 deg (mass means).
! Injection Tt is overwritten by extraction mass-weighted Tt before every full step.
! Upper half-domain P2 mesh in metres; symmetry plane at y = 0.
! Euler equations through NS with Reynolds number = 0 (zero viscosity).
Flow equations                   = NS
mesh file name                   = MESH/cdv_fan_turbine_1cell_gap_p2.msh
reference length (m)             = 1.0
Polynomial order i               = 2
Polynomial order j               = 2
Polynomial order k               = 1
Discretization nodes             = Gauss-Lobatto

! Isentropic exit reference state; reference Mach does not fix inlet Mach.
mach number                      = 0.1701307342730733
Reynolds number                  = 0.0
Prandtl number                   = 0.72
reference temperature (k)        = 55.235801392257024
reference pressure (pa)          = 6756.86214730464
AOA theta                        = 0.0
AOA phi                          = 0.0
gravity direction                = [0.0,0.0,0.0]
LES model                        = none
enable shock-capturing           = .false.

inviscid discretization          = standard
riemann solver                   = roe
compute gradients               = .true.
gradient variables              = state
viscous discretization           = BR1
simulation type                  = time-accurate
time integration                 = explicit
explicit method                  = rk3
compute time derivative after timestep = .true.
Number of time steps             = 100000
Convergence tolerance            = 1.d-10
cfl                              = 0.75
dcfl                             = 1e6

Output Interval                  = 100
monitors flush interval          = 100
Number of plot points            = 4
solution file name               = RESULTS/CDVGapNoWorkCoupled.hsol
! Save a separate solution snapshot every 10000 iterations.
autosave mode                    = iteration
autosave interval                = 10000
save gradients with solution     = .false.
restart                          = .false.
restart file name                = RESULTS/CDVGapNoWorkCoupled.hsol
mesh partitioning                = SFC

! NASA plenum: p0 = 1 psi, T0 = 100 degrees Rankine (absolute).
#define boundary inlet
   mass flow statistics = .false.
   type = totalinflow
   total pressure = 6894.757293168
   total temperature = 55.55555555555556
   aoatheta = 0.0
   aoaphi = 0.0
#end

#define boundary outlet
   mass flow statistics = .false.
   type = Outflow
   pressure = 6756.86214730464
#end

#define boundary wall_upper
   mass flow statistics = .false.
   type = FreeSlipWall
#end

#define boundary symmetry
   mass flow statistics = .false.
   ! Euler symmetry: reflect normal momentum, preserve tangential state.
   type = FreeSlipWall
#end

#define boundary z_min
   mass flow statistics = .false.
   type = FreeSlipWall
#end

#define boundary z_max
   mass flow statistics = .false.
   type = FreeSlipWall
#end

! Interior-state outward mass flux: negative inlet, positive outlet.
#define surface monitor 1
   Name = inlet-mass-flow
   Marker = inlet
   Variable = mass-flow
#end

#define surface monitor 2
   Name = outlet-mass-flow
   Marker = outlet
   Variable = mass-flow
#end

! Symmetry-plane state-flux diagnostic; leakage should be negligible.
#define surface monitor 3
   Name = symmetry-mass-flow
   Marker = symmetry
   Variable = mass-flow
#end


#define boundary fan_inlet
   type = Outflow
   pressure = 6676.328911229583
   mass flow statistics = .true.
   mass flow statistics history capacity = 32768
   mass flow statistics hop samples = 1000
   mass flow statistics adf lags = 4
   mass flow statistics minimum samples = 1000
   mass flow statistics significance = 0.05
   mass flow statistics relative std tolerance = 1e30
   mass flow statistics restart policy = reset
#end

#define boundary fan_outlet
   type = totalinflow
   total pressure = 6894.750052334262
   total temperature = 55.55555555555556
   aoatheta = 0.05988380066238474
   aoaphi = 0.0
   mass flow statistics = .true.
   mass flow statistics history capacity = 32768
   mass flow statistics hop samples = 1000
   mass flow statistics adf lags = 4
   mass flow statistics minimum samples = 1000
   mass flow statistics significance = 0.05
   mass flow statistics relative std tolerance = 1e30
   mass flow statistics restart policy = reset
#end

#define surface monitor 4
   Name = fan_inlet-mass-flow
   Marker = fan_inlet
   Variable = mass-flow
#end

#define surface monitor 5
   Name = fan_outlet-mass-flow
   Marker = fan_outlet
   Variable = mass-flow
#end

#define mass flow balance
   coupling mode = total-temperature
   coupling source boundaries = fan_inlet
   coupling target boundaries = fan_outlet
   enabled = .true.
   constraint = equal-mass-flow
   algorithm = safeguarded-secant
   ! Outward signed flux: +fan_inlet, -fan_outlet; coefficients are both +1.
   observed boundaries = fan_inlet, fan_outlet
   flow coefficients = 1, 1
   controlled boundaries = fan_inlet
   reference mass flow (kg/s) = 2.6126558782407284e-4
   minimum pressure (pa) = 6300.0
   maximum pressure (pa) = 6800.0
   probe pressure step (pa) = 2.0
   maximum pressure step (pa) = 10.0
   relaxation = 0.7
   relative mass tolerance = 5e-4
   absolute mass tolerance (kg/s) = 1e-10
   mean error fraction = 0.25
   average block duration (s) = 5e-4
   minimum settle steps = 1000
   restart policy = reset
#end
